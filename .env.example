# ===========================================================================
#  DemoBank - environment configuration template
# ===========================================================================
#  Copy this file to `.env` before the first start:
#
#      cp .env.example .env
#
#  `.env` is git-ignored on purpose: it contains secrets.
#  Everything in this file is DEMO data. Never reuse these values anywhere
#  real, and never put real personal or banking data in this application.
# ===========================================================================

# --- JWT signing key -------------------------------------------------------
# The API signs every access token with this key (HMAC-SHA256).
# It MUST be at least 32 characters (256 bits) or the application refuses to
# start. Anyone who knows this value can forge a valid token for any user.
#
# Generate a strong one with:   openssl rand -base64 48
#
# The value below is the shipped demo default. The application detects it and
# logs a loud warning at startup; under the `prod` profile it refuses to boot.
JWT_SECRET=CHANGE_ME_demo_only_3f8a1c9e5b7d2460af13c8e6d94b7205

# --- MySQL ----------------------------------------------------------------
DB_NAME=demobank
DB_ROOT_PASSWORD=demo_root_pwd_change_me

# Least-privilege account used by the API at runtime: DML only
# (SELECT/INSERT/UPDATE/DELETE). It cannot alter the schema or drop tables.
DB_APP_USER=demobank_app
DB_APP_PASSWORD=demo_app_pwd_change_me

# Schema-owner account used only by Flyway at startup: it owns the DDL rights
# needed to create/alter tables. The API itself never connects with it.
DB_MIGRATOR_USER=demobank_migrator
DB_MIGRATOR_PASSWORD=demo_migrator_pwd_change_me

# --- Published ports (host side) ------------------------------------------
# Only the web entrypoint is exposed. MySQL is bound to the loopback
# interface so it is reachable from this machine only, never from the network.
WEB_PORT=8080
MYSQL_HOST_PORT=3307

# --- Spring profile --------------------------------------------------------
# `demo` = didactic defaults (OpenAPI UI enabled, relaxed CSP for Swagger).
# `prod` = hardened defaults (API docs off, strict CSP, demo secret rejected).
SPRING_PROFILES_ACTIVE=demo

# --- Images ----------------------------------------------------------------
# Which images `docker compose up` runs. The defaults below are built locally
# from the Dockerfiles. Point them at the registry to run what the CI pipeline
# published instead:
#
#     docker compose pull && docker compose up -d --no-build
#
# (`--no-build` matters: because `build:` is still declared, compose would
# otherwise rebuild from source when the image is not present locally.)
BACKEND_IMAGE=demobank/backend:1.0.0
FRONTEND_IMAGE=demobank/frontend:1.0.0
